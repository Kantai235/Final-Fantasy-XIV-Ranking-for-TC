  "patches": [
    { "patch": "7.0", "major": true, "title": "黃金遺產", "international": "2024-07-02", "international_source": "international_launch", "tc": "2025-12-10", "tc_source": "tc_launch",
      "note": "兩服皆以正式上市日期為準，不含搶先體驗；繁中服開服即包含先前資料片的主線內容。\n\n「水果碼頭」乙太之光已於繁中服 7.0 開放，對應國際服 7.1 的新增設施；佩魯佩魯族任務仍於繁中服 7.1 推出，不能把傳送點提前開放視為整個部族內容已開放。",
      "note_sources": [{ "label": "繁中服 7.1 筆記（回溯 7.0）", "source": "tc_7_1_notes" }, { "label": "國際服 7.1 筆記", "source": "international_7_1_notes" }] },
    { "patch": "7.01", "major": false, "title": "小版本更新", "international": "2024-07-16", "international_source": "international_2024", "tc": "2026-02-10", "tc_source": "tc_7_01" },
    { "patch": "7.05", "major": false, "title": "小版本更新", "international": "2024-07-30", "international_source": "international_2024", "tc": "2026-03-10", "tc_source": "tc_7_05",
      "note": "繁中服於此版開放土地抽選與房屋系統，屬於在地開服安排。輕量級零式、加加財富天坑與天道神典石則與國際服同為 7.05 內容；房屋系統開放不代表國際服 7.05 才新增房屋玩法。",
      "note_sources": [{ "label": "繁中服 7.05 筆記", "source": "tc_7_05_notes" }, { "label": "國際服 7.05 筆記", "source": "international_7_05_notes" }] },
    { "patch": "7.1", "major": true, "title": "與未知的邂逅", "international": "2024-11-12", "international_source": "international_2024", "tc": "2026-04-21", "tc_source": "tc_7_1",
      "note": "佩魯佩魯族任務於此版開放；據點「水果碼頭」的乙太之光已先於繁中服 7.0 提供，國際服則於 7.1 一併實裝。\n\n本版也已套用國際服 7.11 的絕本規則：隊內有重複特職時，極限槽不再隨時間自動累積；瀕死治療等其他累積方式仍有效。這項規則提前套用，不代表「絕 光暗未來」已在本版開放。",
      "note_sources": [{ "label": "繁中服 7.1 筆記", "source": "tc_7_1_notes" }, { "label": "國際服 7.1 筆記", "source": "international_7_1_notes" }, { "label": "國際服 7.11 筆記", "source": "international_7_11_notes" }] },
    { "patch": "7.11", "major": false, "title": "小版本更新", "international": "2024-11-26", "international_source": "international_2024", "tc": "2026-05-26", "tc_source": "tc_7_11",
      "note": "「絕 光暗未來」於此版開放；國際服 7.11 同時加入的「絕本重複特職時，極限槽不隨時間累積」規則，已先於繁中服 7.1 套用。這是戰鬥規則與副本開放時間分開安排的例子。",
      "note_sources": [{ "label": "繁中服 7.1 筆記（規則先行）", "source": "tc_7_1_notes" }, { "label": "繁中服 7.11 筆記", "source": "tc_7_11_notes" }, { "label": "國際服 7.11 筆記", "source": "international_7_11_notes" }] },
    { "patch": "7.15", "major": false, "title": "小版本更新", "international": "2024-12-17", "international_source": "international_2024", "tc": "2026-06-23", "tc_source": "tc_7_15",
      "note": "繁中服此版包含國際服 7.16 的職能後續任務、暗雲半魔晶石 5 換 1 交換與水晶衝突第 13 賽季。\n\n另包含國際服 7.18 的「拍照」動作、輕量級一般版利刃週限解除、零式掉落與樓層解限，以及奧戴勒古錢兌換界雷強化藥。\n\n「滅 黑暗之雲」於繁中服 7.15 維護後直接開放；國際服則在 7.15 更新一週後（2024/12/24）開放。以上為具體內容與時程差異，不代表兩服整版完全相同。",
      "note_sources": [{ "label": "繁中服 7.15 筆記", "source": "tc_7_15_notes" }, { "label": "國際服 7.15 筆記", "source": "international_7_15_notes" }, { "label": "國際服 7.16 筆記", "source": "international_7_16_notes" }, { "label": "國際服 7.18 筆記", "source": "international_7_18_notes" }] },
    { "patch": "7.16", "major": false, "title": "小版本更新", "international": "2025-01-21", "tc": null, "tc_source": "tc_7_15_notes", "merged_into": "7.15", "tc_version_omitted": true,
      "note": "職能後續任務、暗雲半魔晶石 5 換 1 交換及水晶衝突第 13 賽季已隨繁中服 7.15 推出。這是部分內容的對照，不代表繁中服曾獨立發布 7.16，亦不代表所有職業調整完全相同。",
      "note_sources": [{ "label": "繁中服 7.15 筆記", "source": "tc_7_15_notes" }, { "label": "國際服 7.16 筆記", "source": "international_7_16_notes" }] },
    { "patch": "7.18", "major": false, "title": "小版本更新", "international": "2025-02-25", "tc": null, "tc_source": "tc_7_15_notes", "merged_into": "7.15", "tc_version_omitted": true,
      "note": "「拍照」動作、輕量級一般版利刃週限解除、零式掉落與樓層解限，以及奧戴勒古錢兌換界雷強化藥，已隨繁中服 7.15 推出。僅標示已核對的內容，不把整個 7.18 視為已同步。",
      "note_sources": [{ "label": "繁中服 7.15 筆記", "source": "tc_7_15_notes" }, { "label": "國際服 7.18 筆記", "source": "international_7_18_notes" }] },
    { "patch": "7.2", "major": true, "title": "探究永久之人", "international": "2025-03-25", "tc": "2026-07-28", "tc_source": "tc_7_2",
      "note": "繁中服此版已包含宇宙探索與宇宙工具；這兩項內容於國際服 7.21 推出。\n\n另提前收錄國際服 7.3 的聊天氣泡、角色顯示範圍擴大、維艾拉族／硌獅族多數頭部裝備顯示，以及集體動作的直拍模式、色差與濾鏡強度設定。這些系統功能已開放，不代表國際服 7.3 的主線與副本也已推出。",
      "note_sources": [{ "label": "繁中服 7.2 筆記", "source": "tc_7_2_notes" }, { "label": "國際服 7.21 筆記", "source": "international_7_21_notes" }, { "label": "國際服 7.3 筆記", "source": "international_7_3_notes" }] },
    { "patch": "7.21", "major": false, "title": "小版本更新", "international": "2025-04-22", "tc": null, "tc_version_omitted": true, "tc_source": "tc_7_2", "merged_into": "7.2", "note": "宇宙探索與宇宙工具已隨繁中服 7.2 推出；這是部分內容的對照，不代表兩服整個版本完全相同。",
      "note_sources": [{ "label": "繁中服 7.2 筆記", "source": "tc_7_2_notes" }, { "label": "國際服 7.21 筆記", "source": "international_7_21_notes" }] },
    { "patch": "7.25", "major": false, "title": "小版本更新", "international": "2025-05-27", "tc": null,
      "tc_plan": { "date": "2026-09-29", "attribution": "記者會暨玩家見面會預告" } },
    { "patch": "7.3", "major": true, "title": "主要版本更新", "international": "2025-08-05", "tc": null, "tc_source": "tc_7_2_notes", "merged_into": "7.2",
      "note": "聊天氣泡、角色顯示範圍擴大、維艾拉族／硌獅族多數頭部裝備顯示，以及集體動作的直拍模式、色差與濾鏡強度設定，已隨繁中服 7.2 推出。此對照僅涉及部分系統功能，不代表 7.3 主線、副本或整版已開放。",
      "note_sources": [{ "label": "繁中服 7.2 筆記", "source": "tc_7_2_notes" }, { "label": "國際服 7.3 筆記", "source": "international_7_3_notes" }] },
