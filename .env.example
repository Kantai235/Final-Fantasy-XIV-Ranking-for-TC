# FFLogs OAuth client credentials
# Google Analytics 4
# Set this to your GA4 Measurement ID (for example: G-XXXXXXXXXX) to enable analytics.
# Leave it blank to keep analytics disabled.
VITE_GA_MEASUREMENT_ID=

# Optional: set to true only when you intentionally want GA events during `npm run dev`.
VITE_GA_ENABLE_IN_DEV=false

# 可選：常見問題頁 FFLogs 檢查工具使用的公開 Apps Script Web App URL。
# 這個 endpoint 必須維持唯讀，且不得回傳 FFLogs OAuth 憑證或站務內部設定。
VITE_FFLOGS_REPORT_STATUS_WEB_APP_URL=https://script.google.com/macros/s/AKfycbw_GPuIIrR84Bse1uCiXz1BM2CzgtzvXqhn8dmbbgIQLs-6Etjw6L2BXxerAx5vcXg-zQ/exec

# 可選：本機測試 workflow 讀取 FFLogs 待收錄 Google Sheet。
# GitHub Actions 正式環境請使用 repository variables / secrets。
# FFLOGS_REFRESH_QUEUE_SPREADSHEET_ID=
# FFLOGS_REFRESH_QUEUE_SHEET_NAME=pending
# FFLOGS_REFRESH_QUEUE_MAX_CODES=50
# FFLOGS_REFRESH_QUEUE_COMPLETE_MAX_ROWS=500
# FFLOGS_REFRESH_QUEUE_COMPLETE_INCLUDE_HIDDEN=false
# GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}

# 複製成 .env 後，選一種格式填入 FFLogs OAuth 憑證。
# 非敏感的爬蟲與站台設定請放在 config/fflogs.json 與 config/site.json。

# 單組憑證
FFLOGS_CLIENT_ID=your_client_id
FFLOGS_CLIENT_SECRET=your_client_secret

# 多組憑證：逗號分隔，ID 與 Secret 數量必須相同。
# FFLOGS_CLIENT_IDS=client_id_1,client_id_2
# FFLOGS_CLIENT_SECRETS=client_secret_1,client_secret_2

# 多組憑證：編號欄位，腳本會檢查 1-20 組。
# FFLOGS_CLIENT_ID_1=client_id_1
# FFLOGS_CLIENT_SECRET_1=client_secret_1
# FFLOGS_CLIENT_ID_2=client_id_2
# FFLOGS_CLIENT_SECRET_2=client_secret_2

# 多組憑證：JSON 陣列，適合放在 GitHub Secret FFLOGS_CLIENT_CREDENTIALS_JSON。
# FFLOGS_CLIENT_CREDENTIALS_JSON=[{"client_id":"client_id_1","client_secret":"client_secret_1"},{"client_id":"client_id_2","client_secret":"client_secret_2"}]

# Cloudflare CDN / 節流規則套用工具。
# Cloudflare API Token 必須放在本機 .env 或 GitHub Secret，不能提交真實值。
# 需要的權限請見 docs/cloudflare-github-pages.md。
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_RULES_API_TOKEN=
# CLOUDFLARE_PURGE_API_TOKEN=
# CLOUDFLARE_HOSTNAME=ranking.init.engineer
# CLOUDFLARE_RATE_LIMIT_REQUESTS_PER_10S=240
# CLOUDFLARE_RULES_API_MAX_ATTEMPTS=3
# CLOUDFLARE_RULES_API_RETRY_BASE_MS=750
# CLOUDFLARE_DATA_EDGE_TTL_SECONDS=7200
# CLOUDFLARE_DATA_BROWSER_TTL_SECONDS=300
# CLOUDFLARE_HTML_EDGE_TTL_SECONDS=7200
# CLOUDFLARE_HTML_BROWSER_TTL_SECONDS=300
# CLOUDFLARE_MEDIA_EDGE_TTL_SECONDS=21600
# CLOUDFLARE_MEDIA_BROWSER_TTL_SECONDS=3600
# CLOUDFLARE_STATIC_EDGE_TTL_SECONDS=31536000
# CLOUDFLARE_STATIC_BROWSER_TTL_SECONDS=31536000

# GitHub PAT used by CI to sync user ranking data repository.
GIT_PAT=
